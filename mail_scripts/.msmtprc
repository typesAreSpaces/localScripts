# Set default values for all following accounts.
defaults
auth           on
tls            on
tls_trust_file ~/.maildir/certificates/root-certificates.pem
logfile        ~/.msmtp.log

# Gmail
account        jcastellanos34@gmail.com
host           smtp.gmail.com
port           587
tls_starttls   on
auth           on
from           jcastellanos34@gmail.com
user           jcastellanos34@gmail.com
passwordeval   pass email/Mbsync-jcastellanos34@gmail.com

# Set a default account
account default : jcastellanos34@gmail.com
